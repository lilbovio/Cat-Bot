# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
TOKEN=
# ID de la aplicación del bot
CLIENT_ID=
# ID del usuario administrador/creador del bot
ADMIN_ID=
# Cadena de conexión de MongoDB (Atlas u otro)
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.5fatnkw.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# ── Dashboard ───────────────────────────────────────────────────────────────
# OAuth2 Client Secret (Developer Portal -> OAuth2 -> Client Secret)
CLIENT_SECRET=
# Secreto aleatorio para firmar las cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET=cambia_esto_por_algo_muy_largo_y_aleatorio
# Puerto del servidor web del dashboard (por defecto: 3001)
DASHBOARD_PORT=3001
# URL base del dashboard (debe coincidir con el Redirect URI registrado en Discord)
DASHBOARD_URL=http://localhost:3001

# Opcionales (con valores por defecto en config.js):
# Invitación al servidor de soporte (usada por /queja)
SUPPORT_INVITE=
# Canal que recibe el mensaje de "bot encendido"
STARTUP_CHANNEL=
# Canal de logs al añadir el bot a un servidor
GUILD_LOG_CHANNEL=
# Canal que recibe errores no controlados
ERROR_CHANNEL=
# Canal de quejas
COMPLAINT_CHANNEL=
# Canal de log de la blacklist
BLACKLIST_LOG_CHANNEL=

# ── Economía ─────────────────────────────────────────────────────────────────
# Monedas base que el usuario gana cada /daily (por defecto: 100)
DAILY_AMOUNT=100
